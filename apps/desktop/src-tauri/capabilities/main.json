{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Local project, export and playground commands for the main window",
  "local": true,
  "windows": ["main"],
  "permissions": [
    "allow-workspace-smoke",
    "allow-select-path",
    "allow-project-list",
    "allow-project-open",
    "allow-project-create",
    "allow-project-validate",
    "allow-project-save",
    "allow-project-recover",
    "allow-generation-plan",
    "allow-generation-write",
    "allow-policy-review",
    "allow-policy-approve",
    "allow-playground-start",
    "allow-playground-stop",
    "allow-playground-discover",
    "allow-playground-call",
    "allow-playground-trace",
    "allow-scenario-run",
    "allow-run-poll",
    "allow-run-cancel"
  ]
}
