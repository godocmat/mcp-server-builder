{
  "name": "mcp-builder-desktop",
  "version": "0.3.0",
  "private": true,
  "packageManager": "npm@11.19.1",
  "engines": {
    "node": "24.22.3 || 26.13.1",
    "npm": "11.19.1 || 11.20.0"
  },
  "scripts": {
    "start": "ng serve --host 127.0.0.1 --port 1420",
    "build": "ng build",
    "test": "ng test --watch=false",
    "test:coverage": "ng test --watch=false --coverage",
    "format:check": "prettier --check package.json angular.json \"tsconfig*.json\" \"ui/src/**/*.{ts,html,css}\" \"src-tauri/{tauri*.conf.json,capabilities/*.json}\"",
    "tauri": "tauri"
  },
  "dependencies": {
    "@angular/common": "22.2.6",
    "@angular/compiler": "22.2.6",
    "@angular/core": "22.2.6",
    "@angular/platform-browser": "22.2.6",
    "@tauri-apps/api": "2.12.4",
    "rxjs": "7.8.2",
    "tslib": "2.9.1"
  },
  "devDependencies": {
    "@angular/build": "22.2.7",
    "@angular/cli": "22.2.7",
    "@angular/compiler-cli": "22.2.6",
    "@tauri-apps/cli": "2.12.4",
    "@vitest/coverage-v8": "5.1.0",
    "jsdom": "31.0.0",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
